PORT=3000

# Leave empty in development to use an in-memory MongoDB automatically.
# For Vercel production, set a MongoDB Atlas URI, or USE_MEMORY_DB=true for an ephemeral demo DB.
DB_URI=

SESSION_SECRET=dev-session-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Legacy alias still accepted if ADMIN_USERNAME is unset:
# ADMIN_EMAIL=admin@example.com

# Use minute to debug with faster games
INTERVAL_MODE=hour

# Supabase project (tank-turn-tactics)
SUPABASE_URL=https://govkfjkcdjfkgebaykaw.supabase.co
SUPABASE_ANON_KEY=

# Set true when no MongoDB Atlas URI is available (ephemeral / demo only)
USE_MEMORY_DB=false
COOKIE_SECURE=false
