<%- include('../partials/head.html') %>

<div class="section">
    <div class="area">
        <h1>Register</h1>

        <form action="/auth/register" method="post">
            <div>
                <p class="error"></p>
                <script>
                    const urlParams = new URLSearchParams(window.location.search);
                    const error = urlParams.get('error')
                    if (error === 'invalid') {
                        document.querySelector("p.error").innerHTML = "Username must be 3–24 characters: letters, numbers, underscore."
                    } else if (error) {
                        document.querySelector("p.error").innerHTML = "Username already taken!"
                    }
                </script>

                <label for="username">Username: </label>
                <input type="text" id="username" name="username" autocomplete="username" minlength="3" maxlength="24" pattern="[A-Za-z0-9_]+" required/>

                <br/>

                <label for="password">Password: </label>
                <input type="password" id="password" name="password" autocomplete="new-password" required/>
            </div>
            <button type="submit">Register</button>
        </form>

        <form action="/auth/guest" method="post" style="margin-top: 12px;">
            <button type="submit">Continue as Guest</button>
        </form>

        <a href="/login">Already have an account? Login</a>
    </div>
</div>

<%- include('../partials/footer.html') %>
