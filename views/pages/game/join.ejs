<%- include('../../partials/head.html') %>

<body>
<div class="container">
    <%- include('../../partials/header.html') %>

    <div>
        <h2><%= t('join.title') %></h2>

        <form action="/game/player" method="POST">
            <p class="error"></p>

            <label for="gameId"><%= t('join.gameCode') %></label>
            <input id="gameId" name="gameId"/>

            <% if (usePassphrase) { %>
                <label for="passphrase"><%= t('join.passphrase') %></label>
                <input id="passphrase" name="passphrase"/>
            <% } %>

            <%- include('../../partials/player_creation_card.ejs') %>

            <button type="submit"><%= t('join.join') %></button>
        </form>
    </div>
</div>

<script>
    const urlParams = new URLSearchParams(window.location.search);
    let error = urlParams.get('error')
    if (error) {
        switch (error) {
            case 'nonexistent':
                error = window.t('join.nonexistent');
                break;
            case 'gameStarted':
                error = window.t('join.gameStarted');
                break;
            case 'server':
                error = window.t('join.server');
                break;
        }
    }
    document.querySelector('.error').innerHTML = error;

    let gameId = urlParams.get('game')

    if (gameId) {
        document.querySelector('#gameId').value = gameId;
    }
</script>
</body>

<%- include('../../partials/footer.html') %>
