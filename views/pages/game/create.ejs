<%- include('../../partials/head.html') %>

<body>
<div class="container">
    <%- include('../../partials/header.html') %>
   <div>
       <h2><%= t('create.title') %></h2>
       <form action="/game" method="POST">
           <div class="formItem">
           <label for="name"><%= t('create.name') %> </label>
           <input id="name" name="name" required/>
           </div>

           <div class="formItem">

           <label for="size"><%= t('create.mapSize') %> </label>
           <select id="size" name="size">
               <option value="10">10x10</option>
               <option value="20">20x20</option>
               <option value="30">30x30</option>
               <option value="40">40x40</option>
           </select>
           </div>

           <div class="formItem">
           <label for="turnTime"><%= t('create.actionsInterval') %> </label>
           <select id="turnTime" name="turnTime">
               <option value=24><%= t('create.hours', { n: 24 }) %></option>
               <option value=12><%= t('create.hours', { n: 12 }) %></option>
               <option value=6><%= t('create.hours', { n: 6 }) %></option>
               <option value=4><%= t('create.hours', { n: 4 }) %></option>
               <option value=3><%= t('create.hours', { n: 3 }) %></option>
               <option value=2><%= t('create.hours', { n: 2 }) %></option>
               <option value=1><%= t('create.hour') %></option>
           </select>
           </div>

           <div class="formItem">
           <label for="actionsPerInterval"><%= t('create.actionAmount') %></label>
           <select id="actionsPerInterval" name="actionsPerInterval">
               <option value=1>1</option>
               <option value=2>2</option>
               <option value=3>3</option>
               <option value=4>4</option>
               <option value=5>5</option>
               <option value=6>6</option>
           </select>
           </div>

           <div class="formItem">
           <label for="doActionQueue"><%= t('create.mode') %></label>
           <select id="doActionQueue" name="doActionQueue">
               <option value="false"><%= t('create.modeAsync') %></option>
               <option value="true"><%= t('create.modeRounds') %></option>
           </select>
           </div>

           <div class="formItem" id="broadcastRow">
               <label for="doBroadcastAction"><%= t('create.broadcast') %></label>
               <input type="hidden" name="doBroadcastAction" value="false" />
               <input id="doBroadcastAction" type="checkbox" name="doBroadcastAction" value="true" checked />
           </div>

           <div class="formItem">
               <label for="doFogOfWar"><%= t('create.fog') %></label>
               <input type="hidden" name="doFogOfWar" value="false" />
               <input id="doFogOfWar" type="checkbox" name="doFogOfWar" value="true" />
           </div>

           <div class="formItem">
               <label for="doBounty"><%= t('create.bounty') %></label>
               <input type="hidden" name="doBounty" value="false" />
               <input id="doBounty" type="checkbox" name="doBounty" value="true" checked />
           </div>

           <div class="formItem">
               <label for="allowAlwaysJoin"><%= t('create.alwaysJoin') %></label>
               <input type="hidden" name="allowAlwaysJoin" value="false" />
               <input id="allowAlwaysJoin" type="checkbox" name="allowAlwaysJoin" value="true" />
           </div>

           <script>
               (function () {
                   const mode = document.getElementById('doActionQueue');
                   const broadcastRow = document.getElementById('broadcastRow');
                   function syncBroadcast() {
                       broadcastRow.style.display = mode.value === 'true' ? '' : 'none';
                   }
                   mode.addEventListener('change', syncBroadcast);
                   syncBroadcast();
               })();
           </script>

           <div class="formItem">

<!--           <label for="password">Optional Passphrase: </label>-->
<!--           <input id="password" name="password"/>-->
           </div>


           <%- include('../../partials/player_creation_card.ejs') %>

           <button type="submit"><%= t('create.create') %></button>
       </form>
   </div>
</div>
</body>

<style>
    input, select {
        margin: 10px 0;
    }
</style>

<%- include('../../partials/footer.html') %>
